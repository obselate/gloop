<Project Sdk="Gsharp.NET.Sdk/0.4.1094-g99735b0667">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>gloop</RootNamespace>
    <AssemblyName>gloop</AssemblyName>
    <Version>0.7.2</Version>
    <Product>Gloop</Product>
    <Description>A keyboard-first file manager for Linux and Wayland.</Description>
    <Authors>obselate</Authors>
    <RepositoryUrl>https://github.com/obselate/gloop</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ExtraLinkerArg Include="-z,pack-relative-relocs" Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' == 'linux-x64'" />
    <Compile Include="src/**/*.gs" />
    <EmbeddedResource Include="src/Resources/ThirdPartyNotices.txt" LogicalName="gloop.ThirdPartyNotices.txt" />
    <EmbeddedResource Include="assets/gloop.png" LogicalName="gloop.Icon.png" />
    <EmbeddedResource Include="assets/io.github.obselate.gloop.metainfo.xml" LogicalName="gloop.Metainfo.xml" />
    <GooMaterialIcon Include="arrow_back" />
    <GooMaterialIcon Include="arrow_forward" />
    <GooMaterialIcon Include="arrow_upward" />
    <GooMaterialIcon Include="audio_file" />
    <GooMaterialIcon Include="bookmark" />
    <GooMaterialIcon Include="bookmark_remove" />
    <GooMaterialIcon Include="bookmarks" />
    <GooMaterialIcon Include="check" />
    <GooMaterialIcon Include="close" />
    <GooMaterialIcon Include="code" />
    <GooMaterialIcon Include="content_copy" />
    <GooMaterialIcon Include="content_cut" />
    <GooMaterialIcon Include="content_paste" />
    <GooMaterialIcon Include="create_new_folder" />
    <GooMaterialIcon Include="crop_square" />
    <GooMaterialIcon Include="delete" />
    <GooMaterialIcon Include="description" />
    <GooMaterialIcon Include="desktop_windows" />
    <GooMaterialIcon Include="download" />
    <GooMaterialIcon Include="draft" />
    <GooMaterialIcon Include="edit" />
    <GooMaterialIcon Include="filter_none" />
    <GooMaterialIcon Include="folder" />
    <GooMaterialIcon Include="folder_off" />
    <GooMaterialIcon Include="folder_open" />
    <GooMaterialIcon Include="folder_zip" />
    <GooMaterialIcon Include="grid_view" />
    <GooMaterialIcon Include="hard_drive" />
    <GooMaterialIcon Include="home" />
    <GooMaterialIcon Include="hourglass_empty" />
    <GooMaterialIcon Include="image" />
    <GooMaterialIcon Include="menu" />
    <GooMaterialIcon Include="movie" />
    <GooMaterialIcon Include="music_note" />
    <GooMaterialIcon Include="open_in_new" />
    <GooMaterialIcon Include="preview" />
    <GooMaterialIcon Include="refresh" />
    <GooMaterialIcon Include="remove" />
    <GooMaterialIcon Include="search" />
    <GooMaterialIcon Include="settings" />
    <GooMaterialIcon Include="splitscreen_vertical_add" />
    <GooMaterialIcon Include="terminal" />
    <GooMaterialIcon Include="video_file" />
    <GooMaterialIcon Include="view_list" />
    <GooMaterialIcon Include="visibility" />
    <GooMaterialIcon Include="visibility_off" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="[0.95.1]" />
    <PackageReference Include="Goo" Version="[0.7.13]" />
    <PackageReference Include="Goo.Animations" Version="[0.2.5]" />
    <PackageReference Include="Goo.Svg" Version="[0.7.13]" />
    <PackageReference Include="Goo.Widgets" Version="[0.2.13]" />
  </ItemGroup>
</Project>
